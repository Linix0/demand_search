# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=replace_me
APP_TIMEZONE=Asia/Shanghai
APP_CORS_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=127.0.0.1,localhost,testserver,api
LOG_LEVEL=INFO

# Data stores
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/industry_pain_radar
REDIS_URL=redis://redis:6379/0
TASK_EXECUTION_MODE=inline

# Search provider selection
SEARCH_PROVIDER_DEFAULT=mock
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# Source providers; real providers are disabled until explicitly configured
SOURCE_PROVIDER_DEFAULT=mock
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
HN_API_BASE_URL=https://hacker-news.firebaseio.com/v0
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
REDDIT_ENABLED=false
PRODUCT_HUNT_TOKEN=
PRODUCT_HUNT_ENABLED=false

# LLM provider (mock works offline; real endpoints remain optional)
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4000
LLM_TEMPERATURE=0.1

# Embedding provider (optional; pipeline must work when disabled)
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Job, provider, and fetch limits
MAX_GLOBAL_CONCURRENCY=3
MAX_PAGE_BYTES=204800
MAX_REDIRECTS=5
FETCH_TIMEOUT_SECONDS=20
CONNECT_TIMEOUT_SECONDS=15
MAX_RETRIES=3
DEFAULT_JOB_MAX_ITEMS=500
DEFAULT_JOB_MAX_QUERIES=20
DEFAULT_JOB_MAX_RESULTS_PER_QUERY=30
DEFAULT_JOB_MAX_COST=5.00
COST_CURRENCY=USD
ALLOWED_FETCH_PORTS=80,443

# Retention and provider policy
DEFAULT_RETENTION_DAYS=90
STORE_FULL_PAGE_TEXT=false
REQUIRE_PROVIDER_POLICY_CONFIRMATION=true
